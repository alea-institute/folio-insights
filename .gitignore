# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Environment
.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# Output — ignore generated corpora by default, but ship the two baseline corpora
# used by the Railway dev deploy so the image has data to render.
output/*
!output/default/
!output/test1/
!output/demo/

# Dagger CI driver (Plan 00-05 — package renamed ci/ to avoid dagger-io shadow)
ci/.venv/
ci/__pycache__/
.dagger-cache/

# Local env vars (example is committed; actual .env.docker is NOT)
.env.docker

# pytest-benchmark run-history cache (Plan 00-06 Gate 2 harness).
# bench-results.json is committed (Plan 00-08 DECISION.md consumes it directly);
# .benchmarks/ is per-run autosave history and should stay local.
.benchmarks/

# Phase 1 reviewer DID stub (OQ-4; never commit private keys)
.folio-insights/

# Benchmark corpus fixture — REVERSES decision D-15 (Plan 00-02 had committed it).
# The 235MB fixtures/bench.nq exceeds GitHub's 100MB hard limit and blocked all
# pushes. It is deterministic and regenerable (SHA256 ffb2c130...), so we keep it
# local-only and regenerate on demand instead of committing it:
#   uv run folio-insights bench gen --seed 42 --target 1000000 \
#     --profile phase-0-gate --out fixtures/bench.nq
fixtures/bench.nq


# Local pipeline scratch. `staging/` holds ingest inputs and run logs for ad-hoc
# UAT slices — including third-party source manuscripts. This repo is PUBLIC, so
# nothing under staging/ may ever be committed (the feat/wire-decompose-tagger
# branch swept a book chapter + 280KB of run logs in here before this guard).
staging/

# Generated FOLIO lexicon/governance caches (regenerable, ~11MB, no consumer in
# the tree). Build artifacts, not source.
data/governance/

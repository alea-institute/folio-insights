# syntax=docker/dockerfile:1.7

# =========================================================================
# Dockerfile.web — Web tier (FastAPI + SvelteKit adapter-static SPA, JVM-free)
# REQ-QUALITY-03 two-stage split (no JVM on web); REQ-OBS-04 reproducible (Gate 5)
#
# Base-image digests captured via `docker buildx imagetools inspect` on
# 2026-04-22. Regenerate quarterly or when upstream security advisory lands.
#   node:22-slim      -> sha256:d415caac2f1f77b98caaf9415c5f807e14bc8d7bdea62561ea2fef4fbd08a73c
#   python:3.11-slim  -> sha256:92c262cbb2e99cdc16218338d74fbe518055c13d224d942708f70f8042ff6d18
#   ghcr.io/astral-sh/uv:0.12.23 -> sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21
#     (captured 2026-10-04; keep in step with UV_IMAGE in Dockerfile.worker)
#
# Reproducible over time, not just back to back: every input that reaches the
# image bytes is pinned by digest or hash —
#   base images and uv           @sha256 digests (above)
#   third-party Python packages  requirements.lock (--require-hashes, wheels only)
#   folio-propositions (git)     requirements.vcs.lock (full commit SHA)
#   build backend (hatchling)    requirements.build.lock (hash-verified constraints)
#   SPA dependencies             viewer/package-lock.json (npm ci, integrity hashes)
# The builder's apt `git` is unpinned but never reaches the image: it only
# checks out the pinned commit, whose tree the commit SHA fixes.
# =========================================================================

ARG NODE_IMAGE=node:22-slim@sha256:d415caac2f1f77b98caaf9415c5f807e14bc8d7bdea62561ea2fef4fbd08a73c
ARG PYTHON_IMAGE=python:3.11-slim@sha256:92c262cbb2e99cdc16218338d74fbe518055c13d224d942708f70f8042ff6d18
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21
ARG SOURCE_DATE_EPOCH=0  # Phase 03.5: default 0 so Railway (no build-arg) gets a valid int; hatchling int(SOURCE_DATE_EPOCH) crashed on "". Dagger/CI still overrides with the real commit epoch.

# uv binary source. A named stage because COPY --from does not expand build args.
FROM ${UV_IMAGE} AS uv

# -------------------------------------------------------------------------
# Stage 1: Frontend builder — SvelteKit adapter-static (SPA) build
# -------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS frontend-builder
ARG SOURCE_DATE_EPOCH=0  # Phase 03.5: default 0 so Railway (no build-arg) gets a valid int; hatchling int(SOURCE_DATE_EPOCH) crashed on "". Dagger/CI still overrides with the real commit epoch.
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

WORKDIR /app/viewer
COPY viewer/package.json viewer/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY viewer/ ./
RUN npm run build

# -------------------------------------------------------------------------
# Stage 2: Python dependency builder — git stays in this stage. Nothing here
# compiles: third-party packages install as wheels only, and the two local
# builds (folio-propositions, folio-insights) are pure-Python hatchling builds.
# The runtime copies only the finished virtual environment (no git, no gcc).
# -------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS python-builder
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=uv /uv /uvx /bin/

# git checks out folio-propositions at its pinned commit (requirements.vcs.lock).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Gate 5 step 5: the web dependency closure, exported from uv.lock by
# scripts/export_image_locks.py (the same set local dev and tests run against).
#   1. requirements.lock — every third-party package, --require-hashes, and
#      --only-binary :all: so no sdist is ever compiled.
#   2. requirements.vcs.lock — git dependencies at the full commit SHA uv.lock
#      resolved; --no-deps because their requirements are already in (1).
#   3. the folio_insights project itself from src/, --no-deps.
# Builds in (2) and (3) run hatchling pinned and hash-verified by
# requirements.build.lock (--build-constraints).
# The dependency layers come before COPY src/, so a source change reuses them.
# Gate 5: uv writes <dist>.dist-info/uv_cache.json (source mtimes, a cache key)
# for the local folio-insights install; it and its RECORD line are dropped so
# the venv does not depend on checkout timestamps.
# Ordered explicit COPY (Gate 5 step 8) — NEVER `COPY . .`.
COPY requirements.lock requirements.vcs.lock requirements.build.lock ./
RUN uv venv /opt/venv \
    && uv pip install --python /opt/venv/bin/python --no-cache \
        --require-hashes --only-binary :all: \
        -r requirements.lock \
    && uv pip install --python /opt/venv/bin/python --no-cache --no-deps \
        --build-constraints requirements.build.lock \
        -r requirements.vcs.lock
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN uv pip install --python /opt/venv/bin/python --no-cache --no-deps \
        --build-constraints requirements.build.lock \
        . \
    && for f in /opt/venv/lib/python3.11/site-packages/*.dist-info/uv_cache.json; do \
        [ -e "$f" ] || continue; \
        rm "$f"; sed -i '/\/uv_cache\.json,/d' "$(dirname "$f")/RECORD"; \
    done \
    && find /opt/venv -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /opt/venv -name "*.pyc" -delete \
    && rm -rf /root/.cache

# -------------------------------------------------------------------------
# Stage 3: Python runtime — FastAPI serving the static SPA build + /api
# -------------------------------------------------------------------------
FROM ${PYTHON_IMAGE}
ARG SOURCE_DATE_EPOCH=0  # Phase 03.5: default 0 so Railway (no build-arg) gets a valid int; hatchling int(SOURCE_DATE_EPOCH) crashed on "". Dagger/CI still overrides with the real commit epoch.
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Gate 5 step 4: fixed UID/GID (numeric, deterministic). /app is created here,
# owned by appuser, so the COPYs below need no recursive chown afterwards.
RUN groupadd -g 1001 appuser \
    && useradd -u 1001 -g 1001 -m -s /bin/bash appuser \
    && mkdir -p /app /home/appuser/.folio-insights \
    && chown appuser:appuser /app \
    && chown -R appuser:appuser /home/appuser
# Gate 5: this RUN must be the stage's FIRST filesystem step. A RUN's cache key
# includes SOURCE_DATE_EPOCH (ARG/ENV above); a COPY or WORKDIR key does not, so
# a WORKDIR or COPY ahead of it was reused from a build under an EARLIER commit,
# carrying that build's older mtimes past rewrite-timestamp (which only clamps
# newer times). Chained after this RUN, every later step re-keys per commit.
# Same rule as Dockerfile.worker; tests/test_image_pins.py enforces it.

WORKDIR /app

# Finished virtual environment only — no compiler, no git (fea2497 goal).
COPY --from=python-builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

COPY --chown=appuser:appuser api/ ./api/
# Phase 03.5: bundle the demo corpora so the dev viewer renders data, not an
# empty list. .dockerignore re-includes output/{default,demo} (mirrors the
# .gitignore whitelist). Default _output_dir is ./output (api/main.py), and
# WORKDIR is /app, so this lands at /app/output with no env var needed.
# Web dev tier only — worker/GA reproducibility (Gate 5) is unaffected.
COPY --chown=appuser:appuser output/ ./output/
COPY --from=frontend-builder --chown=appuser:appuser /app/viewer/build/ ./viewer/build/

USER 1001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://localhost:{os.environ.get(\"PORT\", \"8000\")}/health')"

# Phase 03.5: SPA mode — a single uvicorn process serves the static SvelteKit
# build at / (FastAPI StaticFiles, html=True) AND the /api routes, on one port.
# No node process: the prior `node viewer/build/index.js & uvicorn ...` ran the
# adapter-node SSR server and uvicorn on the SAME $PORT (conflict) and was never
# deployed. Full SSR (separate node + proxy) is deferred to the Phase 20 GA cut.
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

# syntax=docker/dockerfile:1.7

# =========================================================================
# Dockerfile.web — Web tier (FastAPI + SvelteKit adapter-static SPA, JVM-free)
# REQ-QUALITY-03 two-stage split (no JVM on web); REQ-OBS-04 reproducible (Gate 5)
#
# Base-image digests captured via `docker buildx imagetools inspect` on
# 2026-04-22. Regenerate quarterly or when upstream security advisory lands.
#   node:22-slim      -> sha256:d415caac2f1f77b98caaf9415c5f807e14bc8d7bdea62561ea2fef4fbd08a73c
#   python:3.11-slim  -> sha256:92c262cbb2e99cdc16218338d74fbe518055c13d224d942708f70f8042ff6d18
# =========================================================================

ARG NODE_IMAGE=node:22-slim@sha256:d415caac2f1f77b98caaf9415c5f807e14bc8d7bdea62561ea2fef4fbd08a73c
ARG PYTHON_IMAGE=python:3.11-slim@sha256:92c262cbb2e99cdc16218338d74fbe518055c13d224d942708f70f8042ff6d18
ARG SOURCE_DATE_EPOCH=0  # Phase 03.5: default 0 so Railway (no build-arg) gets a valid int; hatchling int(SOURCE_DATE_EPOCH) crashed on "". Dagger/CI still overrides with the real commit epoch.

# -------------------------------------------------------------------------
# Stage 1: Frontend builder — SvelteKit adapter-static (SPA) build
# -------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS frontend-builder
ARG SOURCE_DATE_EPOCH=0  # Phase 03.5: default 0 so Railway (no build-arg) gets a valid int; hatchling int(SOURCE_DATE_EPOCH) crashed on "". Dagger/CI still overrides with the real commit epoch.
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

WORKDIR /app/viewer
COPY viewer/package.json viewer/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY viewer/ ./
RUN npm run build

# -------------------------------------------------------------------------
# Stage 2: Python runtime — FastAPI serving the static SPA build + /api
# -------------------------------------------------------------------------
FROM ${PYTHON_IMAGE}
ARG SOURCE_DATE_EPOCH=0  # Phase 03.5: default 0 so Railway (no build-arg) gets a valid int; hatchling int(SOURCE_DATE_EPOCH) crashed on "". Dagger/CI still overrides with the real commit epoch.
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Phase 03.5: install the web tier via uv from pyproject. The committed
# requirements.lock is an INCOMPLETE Plan 05 draft — it omits fastapi/uvicorn/
# python-multipart and does not install the folio_insights project package, so
# the lock-branch could not boot the app (api/ imports folio_insights 20×). Plan
# 05 will author a COMPLETE hash-pinned web lock and restore the lockfile branch.
# `uv pip install .` builds the folio_insights package from src/, so src/ MUST be
# present BEFORE the install (a prior ordering bug installed an empty package →
# ModuleNotFoundError at boot; never caught because Dockerfile.web was never
# deployed). Trade-off: src/ changes invalidate the dep layer until Plan 05's lock.
# Ordered explicit COPY (Gate 5 step 8) — NEVER `COPY . .`.
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN uv pip install --system --no-cache-dir . \
    && uv pip install --system --no-cache-dir fastapi "uvicorn[standard]" python-multipart \
    && rm -rf /root/.cache

COPY api/ ./api/
# Phase 03.5: bundle the demo corpora so the dev viewer renders data, not an
# empty list. .dockerignore re-includes output/{default,demo,test1} (mirrors the
# .gitignore whitelist). Default _output_dir is ./output (api/main.py), and
# WORKDIR is /app, so this lands at /app/output with no env var needed.
# Web dev tier only — worker/GA reproducibility (Gate 5) is unaffected.
COPY output/ ./output/
COPY --from=frontend-builder /app/viewer/build/ ./viewer/build/

# Gate 5 step 4: fixed UID/GID (numeric, deterministic)
RUN groupadd -g 1001 appuser \
    && useradd -u 1001 -g 1001 -m -s /bin/bash appuser \
    && mkdir -p /home/appuser/.folio-insights \
    && chown -R appuser:appuser /app /home/appuser
USER 1001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://localhost:{os.environ.get(\"PORT\", \"8000\")}/health')"

# Phase 03.5: SPA mode — a single uvicorn process serves the static SvelteKit
# build at / (FastAPI StaticFiles, html=True) AND the /api routes, on one port.
# No node process: the prior `node viewer/build/index.js & uvicorn ...` ran the
# adapter-node SSR server and uvicorn on the SAME $PORT (conflict) and was never
# deployed. Full SSR (separate node + proxy) is deferred to the Phase 20 GA cut.
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

# FOLIO Insights v2 — classes.ttl
# Phase 8 Plan 08-01 / D-08 — non-BFO classes from PRD §7.2 + governance classes
# already targeted by Phase 7 SHACL shapes.
#
# Decision references:
#   D-01  canonical fi: prefix
#   D-05  owl:versionIRI carries VOCAB_VERSION = 2026.05.0
#   D-12  drift audit — every fi:* class Phase 2-7 shapes target lives here
#         so the Plan 08-04 audit can confirm coverage.

@prefix fi: <https://folio-insights.aleainstitute.ai/vocab/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<https://folio-insights.aleainstitute.ai/vocab/classes>
    a owl:Ontology ;
    owl:versionIRI <https://folio-insights.aleainstitute.ai/vocab/2026.05.0/classes> ;
    rdfs:label "FOLIO Insights v2 non-BFO classes" ;
    dc:description "PRD §7.2 axiom tiers + Phase 7 governance classes (Phase 8 D-08, D-12)" .

# ──────────────────────────────────────────────────────────────────────────
# PRD §7.2 axiom tiers + framework
# ──────────────────────────────────────────────────────────────────────────

fi:CommonAxiom a owl:Class ;
    rdfs:label "common axiom" ;
    rdfs:comment "Self-evident, widely-shared proposition (Spinozan axiom tier)." .

fi:Postulate a owl:Class ;
    rdfs:label "postulate" ;
    rdfs:comment "Posited proposition admitted without proof within a framework." .

fi:Definition a owl:Class ;
    rdfs:label "definition" ;
    rdfs:comment "Stipulative or explicative definition (Carnap meaning postulate adjacent)." .

fi:MeaningPostulate a owl:Class ;
    rdfs:label "meaning postulate" ;
    rdfs:comment "Carnap meaning postulate — analytic linkage between terms in a framework." .

fi:Framework a owl:Class ;
    rdfs:label "framework" ;
    rdfs:comment "A linguistic/conceptual framework within which assertions are made." .

# ──────────────────────────────────────────────────────────────────────────
# Core shard class (Phase 2 envelope target — fi:VocabPinShape targets this)
# ──────────────────────────────────────────────────────────────────────────

fi:Shard a owl:Class ;
    rdfs:label "shard" ;
    rdfs:comment """The base shard envelope class. Every fi:* governance event
class below is a subclass either directly or via Phase 7's role-assertion /
content-edit / contest / supersession hierarchy.""" .

# ──────────────────────────────────────────────────────────────────────────
# Phase 7 governance event classes (D-12 drift-audit targets)
# ──────────────────────────────────────────────────────────────────────────

fi:RoleAssertion a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "role assertion" ;
    rdfs:comment "GOV-03: agent X has role Y at time T (governance/shapes/role_assertion_shape.ttl)." .

fi:RoleRevocation a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "role revocation" ;
    rdfs:comment "GOV-03: revoke a previously-asserted role." .

fi:Promotion a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "promotion" ;
    rdfs:comment "GOV-04: hypothesis → attested promotion event (PRD §3.1.2)." .

fi:Demotion a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "demotion" ;
    rdfs:comment "GOV-04: attested → hypothesis demotion event (PRD §3.1.3)." .

fi:Contest a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "contest" ;
    rdfs:comment "GOV-05: marks the target shard as contested (PRD §3.1.3)." .

fi:ContestResolution a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "contest resolution" ;
    rdfs:comment "GOV-05: arbiter / distinguo / aporetic resolution of a contest." .

fi:Distinguo a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "distinguo" ;
    rdfs:comment "PRD §6.1: proposed/confirmed sense-fork." .

fi:Supersession a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "supersession" ;
    rdfs:comment """GOV-04 / VOCAB-05: an event recording that shard A supersedes
shard B (the fi:supersedes ObjectProperty itself lives in predicates.ttl).""" .

fi:Retraction a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "retraction" ;
    rdfs:comment "GOV-06: retraction-cascade event (PRD §3.1.4 / DID-02)." .

fi:ContentEdit a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "content edit" ;
    rdfs:comment "Phase 5: append-only edit-audit event on a mutable shard field." .

fi:GovernanceLog a owl:Class ;
    rdfs:label "governance log" ;
    rdfs:comment """The append-only event log itself
(governance/shapes/governance_log_shape.ttl targets this).""" .

fi:AttestedSignature a owl:Class ;
    rdfs:label "attested signature" ;
    rdfs:comment """Phase 6 DID-substrate signature envelope:
{did, signature, signing_key_id, signed_action, over_content_hash}.""" .

fi:ContestVote a owl:Class ;
    rdfs:subClassOf fi:Shard ;
    rdfs:label "contest vote" ;
    rdfs:comment "GOV-05: individual vote cast in a contest." .

# ──────────────────────────────────────────────────────────────────────────
# Phase 9 U0 — classes the projection writes, and closed-world scopes
# ──────────────────────────────────────────────────────────────────────────

fi:GovernanceEvent a owl:Class ;
    rdfs:label "governance event" ;
    rdfs:comment """A governance event as the storage projection stores it (also a
prov:Activity); its action is fi:action.""" .

fi:ClosedWorldScope a owl:Class ;
    rdfs:label "closed-world scope" ;
    rdfs:comment """A declared closed-world island (PRD §8 P5): the classes and
properties it names are complete inside it, so negation-as-failure holds there
and only there. Subjects join a scope with fi:closedUnder (Phase 9 KTD8).""" .

# U35: classes in the complete validation view (schema 2 and opt-in schema 3).

fi:SimpleAssertionShard a owl:Class ;
    rdfs:label "SimpleAssertionShard" ;
    rdfs:comment "SimpleAssertionShard in the full record validation view." .

fi:DisputedPropositionShard a owl:Class ;
    rdfs:label "DisputedPropositionShard" ;
    rdfs:comment "DisputedPropositionShard in the full record validation view." .

fi:ConflictingAuthoritiesShard a owl:Class ;
    rdfs:label "ConflictingAuthoritiesShard" ;
    rdfs:comment "ConflictingAuthoritiesShard in the full record validation view." .

fi:GlossShard a owl:Class ;
    rdfs:label "GlossShard" ;
    rdfs:comment "GlossShard in the full record validation view." .

fi:HypothesisShard a owl:Class ;
    rdfs:label "HypothesisShard" ;
    rdfs:comment "HypothesisShard in the full record validation view." .

fi:AtomicSimpleAssertionShard a owl:Class ;
    rdfs:label "AtomicSimpleAssertionShard" ;
    rdfs:comment "AtomicSimpleAssertionShard in the full record validation view." .

fi:AtomicDisputedPropositionShard a owl:Class ;
    rdfs:label "AtomicDisputedPropositionShard" ;
    rdfs:comment "AtomicDisputedPropositionShard in the full record validation view." .

fi:AtomicConflictingAuthoritiesShard a owl:Class ;
    rdfs:label "AtomicConflictingAuthoritiesShard" ;
    rdfs:comment "AtomicConflictingAuthoritiesShard in the full record validation view." .

fi:AtomicGlossShard a owl:Class ;
    rdfs:label "AtomicGlossShard" ;
    rdfs:comment "AtomicGlossShard in the full record validation view." .

fi:AtomicHypothesisShard a owl:Class ;
    rdfs:label "AtomicHypothesisShard" ;
    rdfs:comment "AtomicHypothesisShard in the full record validation view." .

fi:Triple a owl:Class ;
    rdfs:label "Triple" ;
    rdfs:comment "Triple in the full record validation view." .

fi:ContentEditRecord a owl:Class ;
    rdfs:label "ContentEdit" ;
    rdfs:comment "ContentEdit in the full record validation view." .

fi:Objection a owl:Class ;
    rdfs:label "Objection" ;
    rdfs:comment "Objection in the full record validation view." .

fi:Reply a owl:Class ;
    rdfs:label "Reply" ;
    rdfs:comment "Reply in the full record validation view." .

fi:AuthorityPosition a owl:Class ;
    rdfs:label "AuthorityPosition" ;
    rdfs:comment "AuthorityPosition in the full record validation view." .

fi:AtomicIdentity a owl:Class ;
    rdfs:label "AtomicIdentity" ;
    rdfs:comment "AtomicIdentity in the full record validation view." .

fi:ShardTag a owl:Class ;
    rdfs:label "ShardTag" ;
    rdfs:comment "ShardTag in the full record validation view." .

fi:PropositionLink a owl:Class ;
    rdfs:label "PropositionLink" ;
    rdfs:comment "PropositionLink in the full record validation view." .

fi:LegacyHierarchy a owl:Class ;
    rdfs:label "LegacyHierarchy" ;
    rdfs:comment "Archived legacy hierarchy only; never active proposition links or navigation." .

fi:MapEntry a owl:Class ;
    rdfs:label "map entry" ;
    rdfs:comment "One key/value entry in a record map." .

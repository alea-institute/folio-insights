# FOLIO Insights v2 — shapes.ttl
# Phase 8 Plan 08-01 / D-04 / D-08 / D-12 — SHACL node shapes co-located with vocab.
#
# Decision references:
#   D-01  canonical fi: prefix
#   D-04  fi:VocabPinShape — Pydantic/SHACL two-belt enforcement of fi:vocabVersion
#   D-05  owl:versionIRI carries VOCAB_VERSION = 2026.05.0
#   D-12  literal-range enums (sh:in) live HERE, not on the property declarations:
#         fi:SignedActionEnumShape (13-value SignedAction Literal mirror)
#         fi:RoleEnumShape (4-value role Literal mirror)
#
# Polarity discipline (mirrors governance/shapes/governance_log_shape.ttl): all
# sh:property constraints declare positive shape-of-the-data; pyshacl reports a
# violation when the data fails the declared shape. The sh:sparql bad-case
# polarity pattern (Phase 7 supersession_shape) ships in Plan 08-03 alongside
# fi:SupersessionAlignmentShape — THIS file ships only the three node shapes
# named in the plan's <action> block.

@prefix fi: <https://folio-insights.aleainstitute.ai/vocab/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<https://folio-insights.aleainstitute.ai/vocab/shapes>
    a owl:Ontology ;
    owl:versionIRI <https://folio-insights.aleainstitute.ai/vocab/2026.05.0/shapes> ;
    rdfs:label "FOLIO Insights v2 SHACL shapes" ;
    dc:description """Phase 8 D-04 + D-12 belts: VocabPin + literal-enum shapes
co-located with the vocab package; sh:sparql alignment shapes ship in Plan 08-03.""" .

# ──────────────────────────────────────────────────────────────────────────
# fi:VocabPinShape — D-04 two-belt enforcement
# ──────────────────────────────────────────────────────────────────────────
#
# Every fi:Shard MUST carry fi:vocabVersion equal to VOCAB_VERSION ("2026.05.0").
# The Pydantic envelope catches typos at construction (Plan 08-02);
# this SHACL belt catches raw-triple smuggling at storage / export.

fi:VocabPinShape a sh:NodeShape ;
    sh:targetClass fi:Shard ;
    sh:property [
        sh:path fi:vocabVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "2026.05.0" ;
        sh:message "fi:vocabVersion must equal VOCAB_VERSION constant (Phase 8 D-04 two-belt enforcement)" ;
    ] .

# ──────────────────────────────────────────────────────────────────────────
# fi:SignedActionEnumShape — D-12 literal-enum belt for fi:signedAction
# ──────────────────────────────────────────────────────────────────────────
#
# Mirrors src/folio_insights/shards/envelope.py:85 SignedAction Literal
# (13 values). The Pydantic Literal type enforces at construction; this
# SHACL belt enforces at storage / export and gives the drift-audit
# (Plan 08-04) a single TTL artifact to grep against.

fi:SignedActionEnumShape a sh:NodeShape ;
    sh:targetSubjectsOf fi:signedAction ;
    sh:property [
        sh:path fi:signedAction ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "extract"
            "promote"
            "demote"
            "contest"
            "supersede"
            "retract"
            "distinguo"
            "role_assertion"
            "role_revocation"
            "resolve_contest"
            "content_edit"
            "reparent"
            "reconcile"
        ) ;
        sh:message "fi:signedAction must be one of the 13 SignedAction Literal values (D-12; mirrors envelope.py:85)" ;
    ] .

# ──────────────────────────────────────────────────────────────────────────
# fi:RoleEnumShape — D-12 literal-enum belt for fi:hasRole
# ──────────────────────────────────────────────────────────────────────────
#
# Mirrors PRD §7.1 hasRole Literal range — extractor / reviewer / arbiter /
# corpus_admin. Phase 7's role_assertion_shape.ttl carries the same enum on
# fi:role (the per-event property); this shape covers fi:hasRole (the
# subject-side property).

fi:RoleEnumShape a sh:NodeShape ;
    sh:targetSubjectsOf fi:hasRole ;
    sh:property [
        sh:path fi:hasRole ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in (
            "extractor"
            "reviewer"
            "arbiter"
            "corpus_admin"
        ) ;
        sh:message "fi:hasRole must be one of: extractor, reviewer, arbiter, corpus_admin (D-12)" ;
    ] .

# ──────────────────────────────────────────────────────────────────────────
# fi:DistinctionKindEnumShape — VOCAB-02 distinction-kind literal-enum belt
# ──────────────────────────────────────────────────────────────────────────
#
# Plan 08-04 D-12 in-scope drift fix: the 4 Scotist distinction-kind values
# (realis / rationis / rationis_cum_fundamento_in_re / analogica) are part of
# the VOCAB-02 acceptance gate ("4 predicates + 4 distinction kinds queryable",
# REQUIREMENTS.md). predicates.ttl declares fi:distinctionKind as an
# owl:DatatypeProperty (literal range, PRD §7.1.1); this shape attaches the
# closed enumeration belt — same modeling route as fi:hasRole + fi:signedAction.
# Plan 08-04 Task 2 (test_vocab_02_distinction_kinds_queryable_in_both_stores)
# accepts either NamedIndividual or sh:in literal; we pick Route B (sh:in)
# because it keeps the closed-set semantics on the property declaration where
# the SHACL belt is checked, mirroring fi:RoleEnumShape's discipline exactly.

fi:DistinctionKindEnumShape a sh:NodeShape ;
    sh:targetSubjectsOf fi:distinctionKind ;
    sh:property [
        sh:path fi:distinctionKind ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "realis"
            "rationis"
            "rationis_cum_fundamento_in_re"
            "analogica"
        ) ;
        sh:message "fi:distinctionKind must be one of the 4 Scotist values: realis, rationis, rationis_cum_fundamento_in_re, analogica (PRD §7.1.1 / VOCAB-02)" ;
    ] .

# ──────────────────────────────────────────────────────────────────────────
# fi:SupersessionAlignmentShape — D-10 valid-time alignment
# ──────────────────────────────────────────────────────────────────────────
#
# When shard A fi:supersedes shard B, B.fi:validTimeEnd MUST equal
# A.fi:validTimeStart. The half-open interval [start, end) contract from
# PRD §21.9 requires the boundary be shared so old/new shards tile the
# timeline without gaps or overlaps.
#
# Polarity discipline (mirrors governance/shapes/supersession_shape.ttl:47-58
# and governance_log_shape.ttl:60-74): the sh:sparql SELECT matches the BAD
# case — non-empty result set yields conforms=False. Polarity spiked against
# pyshacl 0.31.0 + rdflib 7.6.0.
#
# T-08-11 mitigation: this shape catches misaligned supersession chains at
# storage / export time even when the application layer would have accepted
# them. The Pydantic envelope cannot enforce cross-shard alignment because
# it sees one shard at a time; SHACL with sh:sparql crosses the boundary.

fi:SupersessionAlignmentShape a sh:NodeShape ;
    sh:targetSubjectsOf fi:supersedes ;
    # Constraint 1: B has fi:validTimeEnd but it doesn't match A's fi:validTimeStart.
    sh:sparql [
        sh:message "fi:SupersessionAlignmentShape: A fi:supersedes B requires B.fi:validTimeEnd == A.fi:validTimeStart (PRD §21.9 / Phase 8 D-10)" ;
        sh:prefixes <https://folio-insights.aleainstitute.ai/vocab/shapes> ;
        sh:select """
            PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
            SELECT $this ?b ?aStart ?bEnd WHERE {
                $this fi:supersedes ?b .
                $this fi:validTimeStart ?aStart .
                ?b fi:validTimeEnd ?bEnd .
                FILTER(?aStart != ?bEnd)
            }
        """ ;
    ] ;
    # Constraint 2 (CR-02): B is missing fi:validTimeEnd entirely — a still-current
    # shard cannot be superseded (chain integrity violation per PRD §21.9).
    # Without this, the join on ?b fi:validTimeEnd in Constraint 1 returned zero
    # rows for open-ended superseded shards and the shape silently passed.
    sh:sparql [
        sh:message "fi:SupersessionAlignmentShape: A fi:supersedes B but B has no fi:validTimeEnd (still-current shard cannot be superseded, PRD §21.9 / Phase 8 D-10)" ;
        sh:prefixes <https://folio-insights.aleainstitute.ai/vocab/shapes> ;
        sh:select """
            PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
            SELECT $this ?b WHERE {
                $this fi:supersedes ?b .
                FILTER NOT EXISTS { ?b fi:validTimeEnd ?bEnd . }
            }
        """ ;
    ] .

# sh:declare block — gives the sh:sparql constraint a place to resolve the
# fi: prefix via sh:prefixes above. The ontology node already exists at the
# top of this file; we attach the sh:declare to it so pyshacl can find both.

<https://folio-insights.aleainstitute.ai/vocab/shapes>
    sh:declare [
        sh:prefix "fi" ;
        sh:namespace "https://folio-insights.aleainstitute.ai/vocab/"^^xsd:anyURI ;
    ] .

# FOLIO Insights v2 — predicates.ttl
# Phase 8 Plan 08-01 / D-08 — all PRD §7.1 fi:* properties live here.
#
# Decision references:
#   D-01  canonical fi: prefix https://folio-insights.aleainstitute.ai/vocab/
#   D-05  owl:versionIRI carries VOCAB_VERSION = 2026.05.0
#   D-10  fi:supersedes / fi:supersededBy declared as owl:inverseOf pair
#   D-12  literal-range enums (sh:in for fi:signedAction, fi:role) live in
#         shapes.ttl, not here — predicates here just declare the property
#         + rdfs:range xsd:string.

@prefix fi: <https://folio-insights.aleainstitute.ai/vocab/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<https://folio-insights.aleainstitute.ai/vocab/predicates>
    a owl:Ontology ;
    owl:versionIRI <https://folio-insights.aleainstitute.ai/vocab/2026.05.0/predicates> ;
    rdfs:label "FOLIO Insights v2 predicates" ;
    dc:description "PRD §7.1 fi:* predicate definitions (Phase 8 D-08)" .

# ──────────────────────────────────────────────────────────────────────────
# Analogia (PRD §7.1.1 — VOCAB-02)
# ──────────────────────────────────────────────────────────────────────────

fi:primeAnalogate a owl:ObjectProperty ;
    rdfs:label "prime analogate" ;
    rdfs:comment "The focal sense in an analogical relation (analogia ad unum)." .

fi:proportionalRelation a owl:ObjectProperty ;
    rdfs:label "proportional relation" ;
    rdfs:comment "Analogy of proportion (a:b :: c:d) link between two pairs of analogues." .

fi:distinguishes a owl:ObjectProperty ;
    rdfs:label "distinguishes" ;
    rdfs:comment "Marks the related shard as a distinguishing concept (distinguo)." .

fi:distinctionKind a owl:DatatypeProperty ;
    rdfs:label "distinction kind" ;
    rdfs:range xsd:string ;
    rdfs:comment """The kind of distinction (Scotist taxonomy): realis,
rationis, rationis_cum_fundamento_in_re, analogica.""" .

# ──────────────────────────────────────────────────────────────────────────
# Elaboration (Tractarian — PRD §7.1.2)
# ──────────────────────────────────────────────────────────────────────────

fi:elaborates a owl:ObjectProperty ;
    rdfs:label "elaborates" ;
    rdfs:comment "Tractarian: child shard elaborates parent in the same proposition." .

# ──────────────────────────────────────────────────────────────────────────
# Dependencies (Spinozan — PRD §7.1.3 — VOCAB-03)
# ──────────────────────────────────────────────────────────────────────────

fi:dependsOnAxiom a owl:ObjectProperty ;
    rdfs:label "depends on axiom" ;
    rdfs:comment "Spinozan: this shard logically depends on the referenced axiom." .

fi:dependsOnDefinition a owl:ObjectProperty ;
    rdfs:label "depends on definition" ;
    rdfs:comment "Spinozan: this shard logically depends on the referenced definition." .

# ──────────────────────────────────────────────────────────────────────────
# Closure (Russellian — PRD §7.1.4)
# ──────────────────────────────────────────────────────────────────────────

fi:closureMarker a owl:DatatypeProperty ;
    rdfs:label "closure marker" ;
    rdfs:range xsd:string ;
    rdfs:comment "Russellian: marks a logically-closed propositional unit boundary." .

# ──────────────────────────────────────────────────────────────────────────
# Framework (Carnap — PRD §7.1.5)
# ──────────────────────────────────────────────────────────────────────────

fi:framework a owl:ObjectProperty ;
    rdfs:label "framework" ;
    rdfs:range fi:Framework ;
    rdfs:comment """Carnap: the linguistic/conceptual framework this shard sits within.
The object is the framework's IRI under https://folio-insights.aleainstitute.ai/framework/
(Phase 9 U0: the projection writes an IRI, never a literal; the identifier string
is fi:frameworkId).""" .

fi:inFramework a owl:ObjectProperty ;
    rdfs:label "in framework" ;
    rdfs:subPropertyOf fi:framework ;
    rdfs:comment """Subject is asserted relative to the referenced fi:Framework (an IRI
under the framework namespace, never a literal). Phase 9 U0: this was declared
owl:inverseOf fi:framework (WR-05), but both properties run subject -> framework,
so the inverse axiom asserted the wrong direction (framework -> shard). It is now
rdfs:subPropertyOf fi:framework, which states the intended entailment and stays
inside OWL 2 EL (KTD5; OWL 2 EL has no inverse properties).""" .

# ──────────────────────────────────────────────────────────────────────────
# Epistemic status (PRD §7.1.6)
# ──────────────────────────────────────────────────────────────────────────

fi:epistemicStatus a owl:DatatypeProperty ;
    rdfs:label "epistemic status" ;
    rdfs:range xsd:string ;
    rdfs:comment "Hypothesis / attested / contested / withdrawn / aporetic." .

# ──────────────────────────────────────────────────────────────────────────
# Predication mode (Aristotelian — PRD §7.1.7)
# ──────────────────────────────────────────────────────────────────────────

fi:predicationMode a owl:DatatypeProperty ;
    rdfs:label "predication mode" ;
    rdfs:range xsd:string ;
    rdfs:comment "Aristotelian: per_se / per_accidens / univocal / equivocal / analogical." .

# ──────────────────────────────────────────────────────────────────────────
# Supersession (PRD §7.1.8 / §21.9 / VOCAB-05 / D-10)
# ──────────────────────────────────────────────────────────────────────────

fi:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes" ;
    rdfs:comment """Asserts that the subject shard supersedes the object shard.
D-10: the owl:inverseOf fi:supersededBy axiom lives in expressive.ttl (the OWL 2
DL layer, Phase 9 KTD5): OWL 2 EL has no inverse properties, so the shared TBox
stays EL and the axiom ships with `export --expressive`. The projection writes
both directions explicitly from the shard envelope, so SPARQL needs no inference.""" .

fi:supersededBy a owl:ObjectProperty ;
    rdfs:label "superseded by" ;
    rdfs:comment "Inverse of fi:supersedes (D-10; the owl:inverseOf axiom is in expressive.ttl)." .

# ──────────────────────────────────────────────────────────────────────────
# Valid-time + transaction-time (PRD §7.1.9 — Phase 5 wired)
# ──────────────────────────────────────────────────────────────────────────

fi:validTimeStart a owl:DatatypeProperty ;
    rdfs:label "valid-time start" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Inclusive lower bound for valid-time (when the assertion took effect)." .

fi:validTimeEnd a owl:DatatypeProperty ;
    rdfs:label "valid-time end" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment """Exclusive upper bound for valid-time (when the assertion was
superseded; unbound means still-current).""" .

fi:transactionTime a owl:DatatypeProperty ;
    rdfs:label "transaction time" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Wall-clock instant the assertion was recorded in the substrate." .

# ──────────────────────────────────────────────────────────────────────────
# Contest (PRD §7.1.10 — Phase 7 GOV-05)
# ──────────────────────────────────────────────────────────────────────────

fi:contests a owl:ObjectProperty ;
    rdfs:label "contests" ;
    rdfs:comment "Records that the subject shard is the target of a contest event." .

fi:contestVote a owl:ObjectProperty ;
    rdfs:label "contest vote" ;
    rdfs:comment "Link from a contest to a fi:ContestVote node." .

fi:positionText a owl:DatatypeProperty ;
    rdfs:label "position text" ;
    rdfs:range xsd:string ;
    rdfs:comment "Free-text statement of the contesting position." .

fi:voterDid a owl:DatatypeProperty ;
    rdfs:label "voter DID" ;
    rdfs:range xsd:string ;
    rdfs:comment "DID of the agent that cast the contest vote." .

fi:resolutionPath a owl:DatatypeProperty ;
    rdfs:label "resolution path" ;
    rdfs:range xsd:string ;
    rdfs:comment "How a contest was resolved: arbiter / distinguo / aporetic." .

# ──────────────────────────────────────────────────────────────────────────
# Attestations (PRD §7.1.11 — Phase 6 DID-substrate)
# ──────────────────────────────────────────────────────────────────────────

fi:signedAction a owl:DatatypeProperty ;
    rdfs:label "signed action" ;
    rdfs:range xsd:string ;
    rdfs:comment """The action being signed. The 13-value enumeration matching
src/folio_insights/shards/envelope.py:85 SignedAction Literal lives in
shapes.ttl::fi:SignedActionEnumShape (D-12 — sh:in belongs there, not on the
property declaration itself).""" .

# ──────────────────────────────────────────────────────────────────────────
# Role (PRD §7.1.12 — Phase 7 GOV-03)
# ──────────────────────────────────────────────────────────────────────────

fi:hasRole a owl:DatatypeProperty ;
    rdfs:label "has role" ;
    rdfs:range xsd:string ;
    rdfs:comment """D-12: declared as DatatypeProperty with literal range.
The 4-value enumeration (extractor, reviewer, arbiter, corpus_admin) lives in
shapes.ttl::fi:RoleEnumShape per the same shapes-own-enums discipline.""" .

fi:hasActiveRoleAt a owl:ObjectProperty ;
    rdfs:label "has active role at" ;
    rdfs:comment "Reified link: agent has role X at point-in-time Y (role-assertion event)." .

fi:role a owl:DatatypeProperty ;
    rdfs:label "role" ;
    rdfs:range xsd:string ;
    rdfs:comment "Role literal carried on a fi:RoleAssertion event." .

fi:revokedRole a owl:DatatypeProperty ;
    rdfs:label "revoked role" ;
    rdfs:range xsd:string ;
    rdfs:comment "Role literal carried on a fi:RoleRevocation event." .

# ──────────────────────────────────────────────────────────────────────────
# Content-edit (PRD §7.1.13 — Phase 5)
# ──────────────────────────────────────────────────────────────────────────

fi:editedAt a owl:DatatypeProperty ;
    rdfs:label "edited at" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Instant of a content edit (Phase 5 forward-only audit)." .

fi:editedBy a owl:DatatypeProperty ;
    rdfs:label "edited by" ;
    rdfs:range xsd:string ;
    rdfs:comment "DID of the agent that performed the content edit." .

fi:fieldPath a owl:DatatypeProperty ;
    rdfs:label "field path" ;
    rdfs:range xsd:string ;
    rdfs:comment "Dotted path to the mutable field touched by the edit." .

fi:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale" ;
    rdfs:range xsd:string ;
    rdfs:comment "Free-text justification for a content edit." .

# ──────────────────────────────────────────────────────────────────────────
# Provenance-hash (PRD §7.1.14 — Phase 4/6)
# ──────────────────────────────────────────────────────────────────────────

fi:provenanceHash a owl:DatatypeProperty ;
    rdfs:label "provenance hash" ;
    rdfs:range xsd:string ;
    rdfs:comment "Stable provenance digest over the shard's full lineage." .

fi:canonicalContentHash a owl:DatatypeProperty ;
    rdfs:label "canonical content hash" ;
    rdfs:range xsd:string ;
    rdfs:comment "RFC 8785 JCS hash of the canonical mutable-fields slice (DID-03 / D-12)." .

fi:overContentHash a owl:DatatypeProperty ;
    rdfs:label "over content hash" ;
    rdfs:range xsd:string ;
    rdfs:comment "Hash that an attestation signs over; cross-references fi:canonicalContentHash." .

fi:signingKeyId a owl:DatatypeProperty ;
    rdfs:label "signing key id" ;
    rdfs:range xsd:string ;
    rdfs:comment "Key identifier (did:key z-form or did:plc fragment) used to produce a signature." .

# ──────────────────────────────────────────────────────────────────────────
# Vocab-version pin (D-03 / D-04 — Phase 8 anchor)
# ──────────────────────────────────────────────────────────────────────────

fi:vocabVersion a owl:DatatypeProperty ;
    rdfs:label "vocab version" ;
    rdfs:range xsd:string ;
    rdfs:comment """The VOCAB_VERSION the shard was minted against (D-03).
Two-belt enforcement: Pydantic validator on the envelope side, SHACL
fi:VocabPinShape on the storage side (D-04).""" .

# ──────────────────────────────────────────────────────────────────────────
# Phase 7 governance-event predicates (Plan 08-04 D-12 drift-audit fix)
# ──────────────────────────────────────────────────────────────────────────
#
# Plan 08-04 audit discovered these predicates are emitted by
# src/folio_insights/governance/*.py (Phase 7 GOV-01..07) and the
# governance/shapes/*.ttl SHACL files but were not yet declared in the
# canonical vocab. D-13 in-scope fix: add the property declarations only;
# no Python rename, no shape rewrite, no behaviour change. The Phase 7
# governance audit-log + per-event SHACL shapes already enforce range
# constraints; this commit just gives the audit trail one authoritative
# property declaration per predicate.

fi:hasEvent a owl:ObjectProperty ;
    rdfs:label "has event" ;
    rdfs:domain fi:GovernanceLog ;
    rdfs:comment "Container link from fi:GovernanceLog to an individual governance event (GOV-01)." .

fi:event a owl:ObjectProperty ;
    rdfs:label "event" ;
    rdfs:comment "Generic event link used by the governance audit-log emitter (governance/shape_validation.py)." .

fi:action a owl:DatatypeProperty ;
    rdfs:label "action" ;
    rdfs:range xsd:string ;
    rdfs:comment "Governance-event action discriminator (string mirror of the GovernanceEvent action field)." .

fi:asof a owl:DatatypeProperty ;
    rdfs:label "as-of" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Reified point-in-time for fi:hasActiveRoleAt and other governance event timestamps." .

fi:did a owl:DatatypeProperty ;
    rdfs:label "did" ;
    rdfs:range xsd:string ;
    rdfs:comment "Decentralised Identifier (did:key / did:plc / did:web) carried on an attestation envelope." .

fi:signedAt a owl:DatatypeProperty ;
    rdfs:label "signed at" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Wall-clock instant a fi:AttestedSignature was produced." .

fi:signerDid a owl:DatatypeProperty ;
    rdfs:label "signer DID" ;
    rdfs:range xsd:string ;
    rdfs:comment "DID of the agent who signed a role-assertion / governance event (Phase 7 GOV-03 / DID-substrate)." .

fi:subjectDid a owl:DatatypeProperty ;
    rdfs:label "subject DID" ;
    rdfs:range xsd:string ;
    rdfs:comment "DID of the agent the role assertion is about (Phase 7 GOV-03 role_assertion_shape)." .

fi:shardIri a owl:ObjectProperty ;
    rdfs:label "shard IRI" ;
    rdfs:comment "Link from a governance event to the target shard it operates on (Phase 7 GOV-04/-05/-06)." .

fi:oldShardIri a owl:ObjectProperty ;
    rdfs:label "old shard IRI" ;
    rdfs:comment "Link from a fi:Supersession event to the superseded shard (VOCAB-05; supersession_shape)." .

fi:newShardIri a owl:ObjectProperty ;
    rdfs:label "new shard IRI" ;
    rdfs:comment "Link from a fi:Supersession event to the superseding shard (VOCAB-05; supersession_shape)." .

fi:cascadePreviewHash a owl:DatatypeProperty ;
    rdfs:label "cascade preview hash" ;
    rdfs:range xsd:string ;
    rdfs:comment "Digest pinning the preview set of a retraction cascade (Phase 7 GOV-06 / DID-02)." .

fi:newStatus a owl:DatatypeProperty ;
    rdfs:label "new status" ;
    rdfs:range xsd:string ;
    rdfs:comment "Target epistemic status carried on a promotion / demotion event (Phase 7 GOV-04 / PRD §3.1.2)." .

fi:pending a owl:DatatypeProperty ;
    rdfs:label "pending" ;
    rdfs:comment """Boolean flag marking a governance event as pending resolution (GOV-05
contest workflow). Its rdfs:range xsd:boolean is in expressive.ttl: xsd:boolean is
outside the OWL 2 EL datatype map (Phase 9 KTD5).""" .

fi:position a owl:DatatypeProperty ;
    rdfs:label "position" ;
    rdfs:range xsd:integer ;
    rdfs:comment "Monotonic per-corpus ordinal used by the governance audit-log (Phase 7 GovernanceEvent.position)." .

fi:citedIri a owl:ObjectProperty ;
    rdfs:label "cited IRI" ;
    rdfs:comment "Generic IRI-cite link used by governance events that reference external shards / documents." .

# ──────────────────────────────────────────────────────────────────────────
# Phase 5 revision predicates (Plan 08-04 D-12 drift-audit fix)
# ──────────────────────────────────────────────────────────────────────────

fi:seq a owl:DatatypeProperty ;
    rdfs:label "seq" ;
    rdfs:range xsd:integer ;
    rdfs:comment "0-based append-order index for fi:ContentEdit entries (Phase 5 revision/content_edit_shape)." .

fi:contentEdits a owl:ObjectProperty ;
    rdfs:label "content edits" ;
    rdfs:comment "Link from a shard to its append-only fi:ContentEdit list (Phase 5 revision/shape_validation)." .

# ──────────────────────────────────────────────────────────────────────────
# Phase 0 bench-generator predicates (Plan 08-04 D-12 drift-audit fix)
# ──────────────────────────────────────────────────────────────────────────

fi:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Annotation-pipe confidence score on a reified statement (Phase 0 bench/generator.py:267)." .

fi:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment """Subject-side valid-time start for annotation-pipe reified assertions.
Semantically equivalent to fi:validTimeStart on the shard envelope; kept as a
distinct property for the bench generator's annotation-pipe emission pattern
because it attaches to a reified statement (not a shard) and avoids cross-
cutting the envelope's validation belt.""" .

# ──────────────────────────────────────────────────────────────────────────
# Phase 1 polysemy distinguo predicates (Plan 08-04 D-12 drift-audit fix)
# ──────────────────────────────────────────────────────────────────────────

fi:analogousTo a owl:ObjectProperty ;
    rdfs:label "analogous to" ;
    rdfs:comment """Typed analogy link emitted by polysemy/distinguo.py on a
reviewer-modified polysemy fork. References a fi:primeAnalogate target.""" .

fi:proposedAt a owl:DatatypeProperty ;
    rdfs:label "proposed at" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Instant a distinguo fork was proposed by a reviewer (polysemy/distinguo.py)." .

fi:proposedBy a owl:ObjectProperty ;
    rdfs:label "proposed by" ;
    rdfs:comment "Link to the DID of the reviewer who proposed a distinguo fork (polysemy/distinguo.py)." .

# ──────────────────────────────────────────────────────────────────────────
# Polysemy fixture-loader / extraction predicates (Plan 08-04 D-12 drift-audit fix)
# ──────────────────────────────────────────────────────────────────────────

fi:axiomSummary a owl:DatatypeProperty ;
    rdfs:label "axiom summary" ;
    rdfs:range xsd:string ;
    rdfs:comment "Short summary text attached to an extracted axiom shard (polysemy/fixture_loader.py)." .

fi:sourceDoc a owl:ObjectProperty ;
    rdfs:label "source doc" ;
    rdfs:comment "Link from an extracted shard to its source document IRI (polysemy/fixture_loader.py)." .

fi:termOfArt a owl:DatatypeProperty ;
    rdfs:label "term of art" ;
    rdfs:range xsd:string ;
    rdfs:comment "Legal term-of-art string carried on a polysemy shard fixture (polysemy/fixture_loader.py)." .

# ──────────────────────────────────────────────────────────────────────────
# Phase 9 U0 — terms the storage projection and exports write
# ──────────────────────────────────────────────────────────────────────────
#
# Phase 13's projection (storage/projection.py) and exports (storage/exports.py)
# wrote these terms without declaring them. Every fi: term the projection emits
# is now declared here or in classes.ttl, and tests/vocab/test_projection_terms.py
# fails on any new undeclared one. Ranges are given only where the datatype is
# in the OWL 2 EL datatype map (xsd:boolean and xsd:double are not), so the
# shared TBox stays inside the EL profile (KTD5).

# ── Framework (Carnap — PRD §8 P2) ──

fi:frameworkId a owl:DatatypeProperty ;
    rdfs:label "framework id" ;
    rdfs:range xsd:string ;
    rdfs:comment """The shard envelope's framework identifier string
(`<jurisdiction>.<body>[.<sub>]`, e.g. us.federal.fre). The projection also
links the shard to the framework's IRI with fi:framework.""" .

fi:jurisdiction a owl:DatatypeProperty ;
    rdfs:label "jurisdiction" ;
    rdfs:range xsd:string ;
    rdfs:comment "A framework's jurisdiction prefix (us, us.federal, uk.england, ...) in the framework registry's SKOS export." .

# ── Dependencies (Spinozan — PRD §7.1.3; the four depends_on_* lists) ──

fi:dependsOnPrecedent a owl:ObjectProperty ;
    rdfs:label "depends on precedent" ;
    rdfs:comment "Spinozan: this shard logically depends on the referenced precedent." .

fi:dependsOnShard a owl:ObjectProperty ;
    rdfs:label "depends on shard" ;
    rdfs:comment "Spinozan: this shard logically depends on the referenced shard." .

# ── Envelope fields the projection carries ──

fi:shardType a owl:DatatypeProperty ;
    rdfs:label "shard type" ;
    rdfs:range xsd:string ;
    rdfs:comment "The envelope's shard_type discriminator (simple_assertion, gloss, ...)." .

fi:schemaVersion a owl:DatatypeProperty ;
    rdfs:label "schema version" ;
    rdfs:range xsd:integer ;
    rdfs:comment "The envelope schema version stamp (U17), distinct from fi:vocabVersion." .

fi:contentHash a owl:DatatypeProperty ;
    rdfs:label "content hash" ;
    rdfs:range xsd:string ;
    rdfs:comment "JCS-canonical SHA-256 of the shard's content (revision.canonical_content_hash)." .

fi:sourceUri a owl:ObjectProperty ;
    rdfs:label "source URI" ;
    rdfs:comment "The source document the shard was extracted from (an IRI, or an xsd:anyURI literal when not a valid IRI)." .

fi:sourceSpan a owl:DatatypeProperty ;
    rdfs:label "source span" ;
    rdfs:range xsd:string ;
    rdfs:comment "Locator of the extracted span within the source document." .

fi:extractedAt a owl:DatatypeProperty ;
    rdfs:label "extracted at" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Instant the shard was first extracted." .

fi:firstExtractorDid a owl:DatatypeProperty ;
    rdfs:label "first extractor DID" ;
    rdfs:range xsd:string ;
    rdfs:comment "DID of the extractor that first produced the shard." .

fi:sense a owl:DatatypeProperty ;
    rdfs:label "sense" ;
    rdfs:range xsd:string ;
    rdfs:comment "Fregean sense of the shard's proposition." .

fi:reference a owl:DatatypeProperty ;
    rdfs:label "reference" ;
    rdfs:range xsd:string ;
    rdfs:comment "Fregean reference of the shard's proposition (an identifier string)." .

fi:tripleSubject a owl:DatatypeProperty ;
    rdfs:label "triple subject" ;
    rdfs:range xsd:string ;
    rdfs:comment "Subject of the shard's function-argument triple." .

fi:triplePredicate a owl:DatatypeProperty ;
    rdfs:label "triple predicate" ;
    rdfs:range xsd:string ;
    rdfs:comment "Predicate of the shard's function-argument triple." .

fi:tripleObject a owl:DatatypeProperty ;
    rdfs:label "triple object" ;
    rdfs:range xsd:string ;
    rdfs:comment "Object of the shard's function-argument triple." .

fi:speechAct a owl:DatatypeProperty ;
    rdfs:label "speech act" ;
    rdfs:range xsd:string ;
    rdfs:comment "Wittgensteinian speech-act / language-game context (envelope field 13)." .

fi:bfoCategory a owl:DatatypeProperty ;
    rdfs:label "BFO category" ;
    rdfs:range xsd:string ;
    rdfs:comment """The envelope's four-value BFO category (envelope field 15:
continuant_independent, continuant_dependent, occurrent_process, occurrent_event).
The projection maps it to a spine class with fi:subjectBfoClass.""" .

fi:subjectBfoClass a owl:ObjectProperty ;
    rdfs:label "subject BFO class" ;
    rdfs:comment """The mini-BFO spine class (bfo_spine.ttl) of the shard's triple
subject, mapped from fi:bfoCategory by a fixed table (Phase 9 KTD2):
continuant_independent -> fi:IndependentContinuant, continuant_dependent ->
fi:Continuant (the spine has no dependent-continuant umbrella; the SDC/GDC split
is not recorded in the envelope), occurrent_process and occurrent_event ->
fi:Process (the Phase 8 D-06 event fold). It is a link, not rdf:type on the shard:
a shard is an information artifact, not the entity its subject denotes.""" .

fi:contested a owl:DatatypeProperty ;
    rdfs:label "contested" ;
    rdfs:comment "Whether the shard carries an open contest (an xsd:boolean; the range axiom is in expressive.ttl)." .

fi:reconciliationStrategy a owl:DatatypeProperty ;
    rdfs:label "reconciliation strategy" ;
    rdfs:range xsd:string ;
    rdfs:comment "A ConflictingAuthoritiesShard's ReconciliationStrategy value." .

fi:signedBy a owl:DatatypeProperty ;
    rdfs:label "signed by" ;
    rdfs:range xsd:string ;
    rdfs:comment "DID of an attested signature carried on the shard." .

fi:journalPosition a owl:DatatypeProperty ;
    rdfs:label "journal position" ;
    rdfs:range xsd:integer ;
    rdfs:comment "Corpus journal position of the revision the projection shows." .

fi:signatureCount a owl:DatatypeProperty ;
    rdfs:label "signature count" ;
    rdfs:range xsd:integer ;
    rdfs:comment "Number of attested signatures on the projected revision." .

fi:contentEditCount a owl:DatatypeProperty ;
    rdfs:label "content edit count" ;
    rdfs:range xsd:integer ;
    rdfs:comment "Number of content edits on the projected revision." .

# ── Governance events as the projection stores them ──

fi:logPosition a owl:DatatypeProperty ;
    rdfs:label "log position" ;
    rdfs:range xsd:integer ;
    rdfs:comment "Per-corpus governance log position of a projected governance event." .

fi:signatureOverHash a owl:DatatypeProperty ;
    rdfs:label "signature over hash" ;
    rdfs:range xsd:string ;
    rdfs:comment "Content hash a projected governance event's signature commits to." .

fi:extractorModel a owl:DatatypeProperty ;
    rdfs:label "extractor model" ;
    rdfs:range xsd:string ;
    rdfs:comment "Model identifier carried on an extract governance event." .

fi:primeAnalogateIri a owl:ObjectProperty ;
    rdfs:label "prime analogate IRI" ;
    rdfs:comment "The prime analogate a distinguo governance event names." .

fi:newParentIri a owl:ObjectProperty ;
    rdfs:label "new parent IRI" ;
    rdfs:comment "The new elaboration parent a reparent governance event names." .

fi:strategy a owl:DatatypeProperty ;
    rdfs:label "strategy" ;
    rdfs:range xsd:string ;
    rdfs:comment "The reconciliation strategy a reconcile governance event sets." .

# ── Signed material carried by the exports (storage/exports.py) ──

fi:signedRecord a owl:DatatypeProperty ;
    rdfs:label "signed record" ;
    rdfs:range xsd:string ;
    rdfs:comment "The journal's original shard record bytes (the signed input), carried by exports." .

fi:signedRecordSha256 a owl:DatatypeProperty ;
    rdfs:label "signed record SHA-256" ;
    rdfs:range xsd:string ;
    rdfs:comment "SHA-256 of fi:signedRecord." .

fi:recordSourceSchemaVersion a owl:DatatypeProperty ;
    rdfs:label "record source schema version" ;
    rdfs:range xsd:integer ;
    rdfs:comment "Envelope schema version the stored record was written in." .

fi:signedEvent a owl:DatatypeProperty ;
    rdfs:label "signed event" ;
    rdfs:range xsd:string ;
    rdfs:comment "The journaled governance event JSON with its signature, carried by exports." .

# ── Closed-world islands (PRD §8 P5 — Phase 9 KTD8) ──

fi:closedUnder a owl:ObjectProperty ;
    rdfs:label "closed under" ;
    rdfs:range fi:ClosedWorldScope ;
    rdfs:comment """Marks the subject as a closed-world island under the referenced
fi:ClosedWorldScope: inside that scope a negation-as-failure answer is complete.
A new term, deliberately separate from fi:closureMarker, whose Russellian
unit-boundary meaning is unchanged (Phase 9 KTD8).""" .

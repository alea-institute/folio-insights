PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q04 — Supersession chain: old shards superseded by new versions.
# Phase 0 fixture emits fi:supersededBy edges without the dcterms:valid
# date annotation. Phase 11 will add the annotation via RDF-12 pipe.
#
# Future RDF-12 native form (for Pitfall 1 file-discipline reference):
#   ?old fi:supersededBy ?new {| dcterms:valid ?date |} .
SELECT ?old ?new WHERE {
  GRAPH ?g {
    ?old fi:supersededBy ?new .
  }
}
LIMIT 100

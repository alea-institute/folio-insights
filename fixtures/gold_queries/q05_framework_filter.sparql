PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q05 — Framework filter: shards whose framework matches a known FRE URI.
# Phase 0 fixture uses us.federal.fre / us.federal.frcp; Phase 11+ will add
# scope annotations to framework edges. Query returns framework prefix match.
#
# Future RDF-12 native form (for Pitfall 1 file-discipline reference):
#   ?shard fi:subject ?concept {| fi:confidence ?conf |} .
SELECT DISTINCT ?shard ?framework WHERE {
  GRAPH ?g {
    ?shard fi:framework ?framework .
    FILTER (CONTAINS(STR(?framework), "us.federal.fre"))
  }
}
LIMIT 100

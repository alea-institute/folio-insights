PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q02 — Shards in the advocacy corpus, annotated with confidence (proxy for
# provenance metadata). In a Phase 11 corpus this resolves to prov:wasDerivedFrom
# on the reified statement; Phase 0 fixture carries fi:confidence as the
# annotation vehicle.
# Named-graph restriction pins the corpus (Gate 2 step 3 pattern).
SELECT DISTINCT ?shard ?confidence WHERE {
  GRAPH <https://folio-insights.aleainstitute.ai/corpus/advocacy> {
    {
      ?shard fi:subject ?concept {| fi:confidence ?confidence |}
    } UNION {
      ?stmt a rdf:Statement ;
            rdf:subject ?shard ;
            rdf:predicate fi:subject ;
            fi:confidence ?confidence .
    }
    ?shard fi:corpus ?corpus .
  }
}
LIMIT 100

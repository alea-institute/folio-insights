PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q02 — Advocacy-corpus shards with annotated confidence (provenance proxy).
# Phase 0 fixture uses rdf:Statement reification; Phase 13+ will emit the
# RDF-12 annotation-pipe form documented below. Named-graph restriction
# pins the corpus per Gate 2 step 3.
#
# Future RDF-12 native form (for Pitfall 1 file-discipline reference):
#   ?shard fi:subject ?concept {| fi:confidence ?confidence |} .
SELECT DISTINCT ?shard ?confidence WHERE {
  GRAPH <https://folio-insights.aleainstitute.ai/corpus/advocacy> {
    ?stmt a rdf:Statement ;
          rdf:subject ?shard ;
          rdf:predicate fi:subject ;
          fi:confidence ?confidence .
  }
}
LIMIT 100

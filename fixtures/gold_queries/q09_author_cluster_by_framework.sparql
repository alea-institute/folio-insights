PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q09 — Per-framework shard counts with average annotated confidence.
# Stand-in for "per-framework author-cluster sizes" pending Phase 6 DID
# substrate (author attestation lives in Phase 6+). Annotation-pipe form
# documents future author attestation carry.
SELECT ?framework (COUNT(DISTINCT ?shard) AS ?n) (AVG(?conf) AS ?avgConf) WHERE {
  GRAPH ?g {
    ?shard fi:framework ?framework .
    {
      ?shard fi:subject ?concept {| fi:confidence ?conf |}
    } UNION {
      ?stmt a rdf:Statement ;
            rdf:subject ?shard ;
            rdf:predicate fi:subject ;
            fi:confidence ?conf .
    }
  }
}
GROUP BY ?framework
ORDER BY DESC(?n)

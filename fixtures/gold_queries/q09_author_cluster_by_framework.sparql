PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q09 — Per-framework shard counts (stand-in for "per-framework author-cluster
# sizes" pending Phase 6 DID substrate — author attestation lives in Phase 6+).
# Phase 11+ will annotate the framework edge with author-cluster cardinality.
#
# Future RDF-12 native form (for Pitfall 1 file-discipline reference):
#   ?shard fi:subject ?concept {| fi:author ?author |} .
SELECT ?framework (COUNT(DISTINCT ?shard) AS ?n) WHERE {
  GRAPH ?g {
    ?shard fi:framework ?framework .
  }
}
GROUP BY ?framework
ORDER BY DESC(?n)

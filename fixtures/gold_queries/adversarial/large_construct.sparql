PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Adversarial — Unbounded CONSTRUCT stress (memory + serialization P95).
# Phase 0 fixture is ~1M quads; this query materializes every triple in
# every graph. Gate 1 runs this under pytest-timeout=35s to bound runtime;
# Plan 00-06 Gate 2 will measure P95 serialization latency. Safety: we
# discard the result after counting; no unbounded buffer retention.
CONSTRUCT { ?s ?p ?o } WHERE {
  GRAPH ?g {
    ?s ?p ?o .
  }
}

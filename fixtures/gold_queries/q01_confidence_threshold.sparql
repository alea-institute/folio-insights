PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q01 — Shards whose subject-concept triple is annotated with confidence >= 0.8.
# D-04 STRICT gold. Phase 0 fixture carries the annotation via rdf:Statement
# reification (Plan 02 P2-D2); Phase 13+ will emit RDF-12 annotation-pipe and
# the query SHOULD be rewritten to the pipe form below.
#
# Future RDF-12 native form (for Pitfall 1 file-discipline reference):
#   ?shard fi:subject ?concept {| fi:confidence ?confidence |} .
SELECT DISTINCT ?shard ?confidence WHERE {
  GRAPH ?g {
    ?stmt a rdf:Statement ;
          rdf:subject ?shard ;
          rdf:predicate fi:subject ;
          fi:confidence ?confidence .
    FILTER (?confidence >= 0.8)
  }
}
LIMIT 100

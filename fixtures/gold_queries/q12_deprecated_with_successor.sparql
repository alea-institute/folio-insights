PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q12 — Deprecated shards (with a successor). Phase 0 fixture models
# deprecation as fi:supersededBy (owl:deprecated is a Phase 11 addition).
# Phase 11+ will annotate the successor edge with confidence via pipe.
#
# Future RDF-12 native form (for Pitfall 1 file-discipline reference):
#   ?old fi:supersededBy ?new {| fi:confidence ?c |} .
SELECT DISTINCT ?old ?new WHERE {
  GRAPH ?g {
    ?old fi:supersededBy ?new .
  }
}
LIMIT 100

PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q08 — Seven Principles P1 (non-contradiction): DisputedPropositionShards
# flagged with epistemicStatus=aporetic. Fixture generator attaches
# fi:epistemicStatus "aporetic" to every DisputedPropositionShard.
# Phase 11+ will annotate with violation severity via pipe.
#
# Future RDF-12 native form (for Pitfall 1 file-discipline reference):
#   ?shard fi:subject ?concept {| fi:confidence ?c |} .
SELECT DISTINCT ?shard ?status WHERE {
  GRAPH ?g {
    ?shard a fi:DisputedPropositionShard ;
           fi:epistemicStatus ?status .
    FILTER (STR(?status) = "aporetic")
  }
}
LIMIT 100

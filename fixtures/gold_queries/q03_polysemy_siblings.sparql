PREFIX folio: <https://folio-insights.aleainstitute.ai/>
PREFIX fi: <https://folio-insights.aleainstitute.ai/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q03 — Polysemy siblings: two distinct shards sharing a concept. Fixture
# seeds 50 concept-IRIs per subtype, so concepts are reused across shards.
# Phase 0 encoding is rdf:Statement reification; Phase 13+ will annotate
# each sibling's subject triple with disambiguation confidence via pipe.
#
# Future RDF-12 native form (for Pitfall 1 file-discipline reference):
#   ?sibling1 fi:subject ?concept {| fi:confidence ?c1 |} .
#   ?sibling2 fi:subject ?concept {| fi:confidence ?c2 |} .
SELECT DISTINCT ?sibling1 ?sibling2 ?concept WHERE {
  GRAPH ?g {
    ?sibling1 fi:subject ?concept .
    ?sibling2 fi:subject ?concept .
    FILTER (STR(?sibling1) < STR(?sibling2))
  }
}
LIMIT 50

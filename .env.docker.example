# Base image digest registry — sourced by Dockerfile.web, Dockerfile.worker,
# and dagger/build.py. Single source of truth so Gate 5 (bit-identical digest,
# REQ-OBS-04) has a consistent reference across local, Dagger, and Railway builds.
#
# Regenerate quarterly or on upstream security advisory:
#   docker buildx imagetools inspect python:3.11-slim
#   docker buildx imagetools inspect node:22-slim
#   docker buildx imagetools inspect eclipse-temurin:17-jdk-alpine
#   docker buildx imagetools inspect python:3.11-alpine
#
# Captured: 2026-04-22 (Phase 0 Plan 04; carried forward unchanged in Plan 05).
# Commit updates atomically so Gate 5 digests move together.

# ------------------------------------------------------------------------
# Web tier — Dockerfile.web (node:22-slim frontend builder + python:3.11-slim runtime)
# ------------------------------------------------------------------------
PYTHON_DIGEST=sha256:92c262cbb2e99cdc16218338d74fbe518055c13d224d942708f70f8042ff6d18
NODE_DIGEST=sha256:d415caac2f1f77b98caaf9415c5f807e14bc8d7bdea62561ea2fef4fbd08a73c

# ------------------------------------------------------------------------
# Worker tier — Dockerfile.worker (eclipse-temurin:17-jdk-alpine jlink + python:3.11-alpine runtime)
# ------------------------------------------------------------------------
TEMURIN_DIGEST=sha256:cf02686befe8e1fc3b00da25458bf92d53013b4c358d4a2245ff50e0d81b753a
# A1 CONFIRMED (musllinux wheel for pyoxigraph exists): python:3.11-alpine is the worker runtime.
# If A1 ever flips to slim-fallback, null out ALPINE_PYTHON_DIGEST and use PYTHON_DIGEST above.
ALPINE_PYTHON_DIGEST=sha256:8b5bfdb1fd2d78aa94e21c4d61be52487693f54be7f1021647751ff365795703

# ------------------------------------------------------------------------
# Build-time
# ------------------------------------------------------------------------
# SOURCE_DATE_EPOCH is NOT checked in — sourced from `git log -1 --pretty=%ct`
# at build time so the epoch tracks the HEAD commit (Gate 5 step 2).
